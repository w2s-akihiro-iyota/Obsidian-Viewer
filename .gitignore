# Python
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
*.log

# Content
# Exclude everything in content
content/*
# But keep the samples directory and its contents
!content/samples/

# Images (Static)
# Exclude everything in static/images
static/images/*
# But keep the samples directory and its contents
!static/images/samples/

# Images (Root - precautionary)
images/*
!images/samples/

# Docker
# docker-compose.yml は共通設定として Git 管理する。PC ごとの設定は override に書く
docker-compose.override.yml

# Environment Specific Configs
server_config.yaml
.claude/settings.local.json
