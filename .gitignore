# Python
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
*.log

# Content
# Exclude everything in content
content/*
# But keep the samples directory and its contents
!content/samples/

# Images (Static)
# static/images はアプリの部品（logo.png・samples/ のヘルプ画像）だけを置く。それ以外は追跡しない
static/images/*
!static/images/logo.png
!static/images/samples/

# Media（Vault の添付の同期先。/media で配信する）
# Exclude everything in media
media/*
# But keep the bundled samples (アプリ同梱のサンプル)
!media/_viewer-samples/

# Images (Root - precautionary)
images/*
!images/samples/

# Docker
# docker-compose.yml は共通設定として Git 管理する。PC ごとの設定は override に書く
docker-compose.override.yml

# Environment Specific Configs
server_config.yaml
sync_history.json
.claude/settings.local.json
